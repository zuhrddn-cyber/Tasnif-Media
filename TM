<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TASNIF MEDIA — CapCut Ssenariy & Taymlayn Studio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #0f172a; color: #f8fafc; font-family: 'Inter', sans-serif; }
        .timeline-grid { background-size: 40px 100%; background-image: linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px); }
        .track-block { transition: all 0.2s ease; }
        .track-block:hover { transform: translateY(-2px); filter: brightness(1.15); }
        ::-webkit-scrollbar { height: 8px; width: 8px; }
        ::-webkit-scrollbar-track { background: #1e293b; }
        ::-webkit-scrollbar-thumb { background: #475569; border-radius: 4px; }
    </style>
</head>
<body class="h-screen flex flex-col overflow-hidden">

    <!-- TOP NAVBAR -->
    <header class="h-14 bg-slate-900 border-b border-slate-800 flex items-center justify-between px-6 z-10">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-red-600 rounded-lg flex items-center justify-center font-bold text-white shadow-lg shadow-red-900/40">TM</div>
            <h1 class="font-bold text-lg tracking-wide text-white">TASNIF MEDIA <span class="text-xs px-2 py-0.5 rounded bg-red-500/20 text-red-400 border border-red-500/30 ml-2">Studio Pro</span></h1>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="openImportModal()" class="px-4 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-lg transition flex items-center gap-2">
                <i class="fa-solid fa-file-import"></i> Gemini JSON Import
            </button>
            <button onclick="createNewScenario()" class="px-4 py-1.5 bg-red-600 hover:bg-red-500 text-white text-sm font-medium rounded-lg transition flex items-center gap-2">
                <i class="fa-solid fa-plus"></i> Yangi Ssenariy
            </button>
        </div>
    </header>

    <!-- MAIN WORKSPACE -->
    <div class="flex-1 flex overflow-hidden">
        
        <!-- SIDEBAR: SSENARIYLAR RO'YXATI -->
        <aside class="w-64 bg-slate-900/80 border-r border-slate-800 flex flex-col">
            <div class="p-4 border-b border-slate-800 text-xs font-semibold text-slate-400 uppercase tracking-wider">
                <i class="fa-solid fa-folder-open mr-2"></i> Saqlangan Ssenariylar
            </div>
            <div id="scenarioList" class="flex-1 overflow-y-auto p-2 space-y-1">
                <!-- Javascript dinamik yuklaydi -->
            </div>
        </aside>

        <!-- MAIN CONTENT AREA -->
        <main class="flex-1 flex flex-col bg-slate-950 overflow-hidden">
            
            <!-- HEADER / CONTROL PANEL -->
            <div class="p-4 bg-slate-900/40 border-b border-slate-800 flex items-center justify-between">
                <div>
                    <h2 id="currentTitle" class="text-xl font-bold text-white">Ssenariy Tanlanmagan</h2>
                    <p id="currentDesc" class="text-xs text-slate-400 mt-1">Taymlayndan istalgan blokni bosib tahrirlashingiz mumkin</p>
                </div>
                <div class="flex items-center gap-4">
                    <div class="text-right">
                        <div class="text-xs text-slate-400">Umumiy Vaqt</div>
                        <div id="totalDuration" class="font-mono text-lg font-bold text-red-400">00:00</div>
                    </div>
                </div>
            </div>

            <!-- CAPCUT MULTI-TRACK TIMELINE STUDIO -->
            <div class="flex-1 flex flex-col overflow-hidden p-4">
                
                <div class="text-xs font-semibold text-slate-400 mb-2 flex items-center justify-between">
                    <span><i class="fa-solid fa-sliders mr-2"></i> CAPCUT MULTI-TRACK TAYMLAYN (1.1, 1.2 Bloklar)</span>
                    <span class="text-slate-500">Vaqt shkalasi (Soniya)</span>
                </div>

                <!-- TIMELINE CONTAINER -->
                <div class="flex-1 bg-slate-900 rounded-xl border border-slate-800 flex flex-col overflow-hidden shadow-2xl">
                    
                    <!-- TIME RULER -->
                    <div class="h-8 bg-slate-800/80 border-b border-slate-700 flex items-center pl-48 pr-6 text-xs font-mono text-slate-400 timeline-grid overflow-x-auto">
                        <div class="flex justify-between w-full min-w-[1000px]">
                            <span>00:00</span><span>00:05</span><span>00:10</span><span>00:15</span><span>00:20</span><span>00:25</span><span>00:30</span><span>00:35</span>
                        </div>
                    </div>

                    <!-- TRACKS AREA -->
                    <div id="tracksContainer" class="flex-1 overflow-y-auto overflow-x-auto p-3 space-y-3 timeline-grid min-w-[1200px]">
                        <!-- Tracks JavaScript orqali chiziladi -->
                    </div>
                </div>
            </div>
        </main>

        <!-- RIGHT INSPECTOR PANEL (EDIT BLOCK) -->
        <div id="inspectorPanel" class="w-80 bg-slate-900 border-l border-slate-800 p-4 flex flex-col hidden">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
                <h3 class="font-bold text-white text-sm flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square text-red-400"></i> Blok Tahrirlash
                </h3>
                <button onclick="closeInspector()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
            </div>
            
            <div class="space-y-4 flex-1 overflow-y-auto">
                <div>
                    <label class="text-xs font-semibold text-slate-400 block mb-1">Blok Nomi</label>
                    <input type="text" id="editBlockName" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-red-500">
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-400 block mb-1">Spiker Nutqi / Matn</label>
                    <textarea id="editBlockText" rows="4" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-red-500"></textarea>
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-400 block mb-1">AI Video / B-Roll Prompt</label>
                    <textarea id="editBlockPrompt" rows="3" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-amber-300 font-mono text-xs focus:outline-none focus:border-amber-500"></textarea>
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-400 block mb-1">SFX / Ovoz Effekti va Musiqa</label>
                    <input type="text" id="editBlockAudio" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-emerald-400 focus:outline-none focus:border-emerald-500">
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="text-xs font-semibold text-slate-400 block mb-1">Davomiyligi (Sek)</label>
                        <input type="number" id="editBlockDuration" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white">
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-400 block mb-1">Ovoz Rejimi</label>
                        <select id="editBlockVoiceType" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white">
                            <option value="Spiker Kadrda">Spiker Kadrda</option>
                            <option value="Fon Ovozi (Voiceover)">Fon Ovozi (Voiceover)</option>
                        </select>
                    </div>
                </div>
            </div>

            <button onclick="saveBlockChanges()" class="w-full py-2 bg-red-600 hover:bg-red-500 text-white font-medium rounded-lg text-sm mt-4 transition">
                <i class="fa-solid fa-check mr-2"></i> O'zgarishlarni Saqlash
            </button>
        </div>
    </div>

    <!-- MODAL: GEMINI JSON IMPORT -->
    <div id="importModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4 hidden z-50">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-xl p-6 shadow-2xl">
            <h3 class="text-lg font-bold text-white mb-2 flex items-center gap-2">
                <i class="fa-solid fa-robot text-indigo-400"></i> Gemini JSON Ssenariysini Yuklash
            </h3>
            <p class="text-xs text-slate-400 mb-4">Gemini (mening javobim) yaratgan JSON kodni shu yerga tashlang. Sayt uni avto-taymlaynga aylantiradi.</p>
            <textarea id="jsonInput" rows="8" placeholder='{"title": "Movarounnahr Shaharlari", "blocks": [...]}' class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-xs font-mono text-emerald-400 focus:outline-none focus:border-indigo-500 mb-4"></textarea>
            <div class="flex justify-end gap-3">
                <button onclick="closeImportModal()" class="px-4 py-2 bg-slate-800 text-slate-300 rounded-lg text-sm">Bekor Qilish</button>
                <button onclick="processJSONImport()" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-sm font-medium">Taymlaynga O'tkazish</button>
            </div>
        </div>
    </div>

    <!-- APPLICATION LOGIC -->
    <script>
        // Boshlang'ich Namuna Ssenariysi (Movarounnahr Lost Cities)
        let scenarios = JSON.parse(localStorage.getItem('tasnif_scenarios')) || [
            {
                id: 'sc_1',
                title: 'Yo\'qolgan 5 Buyuk Shahar (10-O\'rin Poykent)',
                desc: 'Poykent va Varaxsha ssenariysi multi-track taymlayni',
                totalTime: '00:35',
                blocks: [
                    { id: 'b1', name: 'Spiker 1.1-nutq', spikerText: '10-o‘rin. Ipak yo‘lining eng boy va gavjum savdo markazlaridan biri bo‘lgan Poykent shahri.', prompt: '3D cinematic view of ancient Sogdian Silk Road merchant city, desert oasis, high detail', sfx: 'Tuyalar qo\'ng\'irog\'i va shamol sadosi', duration: 10, voiceType: 'Spiker Kadrda', track: 'spiker' },
                    { id: 'b2', name: 'AI video 1.1', spikerText: 'Poykent o\'z davrida Osiyo Venetsiyasi deb atalgan.', prompt: 'Ancient Sogdian traders trading gold and silk in crowded Poykent market place', sfx: 'Bozor shovqini va barabanlar', duration: 12, voiceType: 'Fon Ovozi (Voiceover)', track: 'aivideo' },
                    { id: 'b3', name: 'Faktlar keltirilgan 1.1', spikerText: '10-O\'RIN: POYKENT — SAVDOGARLAR SHAHRI', prompt: 'Text motion graphic overlay: POYKENT - ASIAN VENICE', sfx: 'Whoosh transition sound', duration: 8, voiceType: 'Fon Ovozi (Voiceover)', track: 'facts' },
                    { id: 'b4', name: '1.1-fon ovozi', spikerText: 'Nega bu shahar bir kechada tashlab ketilgan? Suv kanallarining qurishi uni sahroga aylantirdi.', prompt: 'Drying riverbed of Zarafshan river, sand dunes covering ancient brick walls', sfx: 'Deep cinematic bass drop', duration: 15, voiceType: 'Fon Ovozi (Voiceover)', track: 'voiceover' }
                ]
            }
        ];

        let currentScenarioId = 'sc_1';
        let selectedBlockId = null;

        function initApp() {
            renderScenarioList();
            loadScenario(currentScenarioId);
        }

        function renderScenarioList() {
            const list = document.getElementById('scenarioList');
            list.innerHTML = '';
            scenarios.forEach(sc => {
                const isActive = sc.id === currentScenarioId;
                list.innerHTML += `
                    <div onclick="loadScenario('${sc.id}')" class="p-3 rounded-lg cursor-pointer transition ${isActive ? 'bg-red-600/20 border border-red-500/40 text-white' : 'hover:bg-slate-800 text-slate-400'}">
                        <div class="font-semibold text-sm truncate">${sc.title}</div>
                        <div class="text-xs text-slate-500 mt-1 flex items-center justify-between">
                            <span><i class="fa-regular fa-clock mr-1"></i> ${sc.totalTime}</span>
                            <span>${sc.blocks.length} blok</span>
                        </div>
                    </div>
                `;
            });
        }

        function loadScenario(id) {
            currentScenarioId = id;
            const sc = scenarios.find(s => s.id === id);
            if (!sc) return;

            document.getElementById('currentTitle').innerText = sc.title;
            document.getElementById('currentDesc').innerText = sc.desc;
            document.getElementById('totalDuration').innerText = sc.totalTime;

            renderScenarioList();
            renderTimeline(sc.blocks);
        }

        function renderTimeline(blocks) {
            const container = document.getElementById('tracksContainer');
            container.innerHTML = '';

            const trackTypes = [
                { id: 'spiker', label: '🎙️ Spiker Nutqi (Kadrda)', color: 'bg-red-900/40 border-red-500/50 text-red-200' },
                { id: 'aivideo', label: '🤖 AI Video / B-Roll (1.1, 1.2)', color: 'bg-amber-900/40 border-amber-500/50 text-amber-200' },
                { id: 'voiceover', label: '🗣️ 1.1, 1.2 Fon Ovozi (Voiceover)', color: 'bg-indigo-900/40 border-indigo-500/50 text-indigo-200' },
                { id: 'facts', label: '📝 Ekranda Faktlar & Titrlar', color: 'bg-emerald-900/40 border-emerald-500/50 text-emerald-200' }
            ];

            trackTypes.forEach(t => {
                let trackHTML = `
                    <div class="flex items-center h-16 bg-slate-900/90 rounded-lg border border-slate-800 overflow-hidden">
                        <div class="w-48 px-3 py-2 bg-slate-800 text-xs font-semibold text-slate-300 border-r border-slate-700 flex items-center">
                            ${t.label}
                        </div>
                        <div class="flex-1 flex items-center gap-2 px-3">
                `;

                const trackBlocks = blocks.filter(b => b.track === t.id);
                trackBlocks.forEach(b => {
                    const widthPx = b.duration * 18;
                    trackHTML += `
                        <div onclick="openInspector('${b.id}')" style="width: ${widthPx}px" class="track-block h-11 ${t.color} border rounded-lg px-2 py-1 text-xs cursor-pointer flex flex-col justify-between overflow-hidden shadow">
                            <div class="font-bold truncate">${b.name}</div>
                            <div class="text-[10px] opacity-75 truncate">${b.spikerText}</div>
                        </div>
                    `;
                });

                trackHTML += `</div></div>`;
                container.innerHTML += trackHTML;
            });
        }

        function openInspector(blockId) {
            selectedBlockId = blockId;
            const sc = scenarios.find(s => s.id === currentScenarioId);
            const block = sc.blocks.find(b => b.id === blockId);
            if (!block) return;

            document.getElementById('editBlockName').value = block.name;
            document.getElementById('editBlockText').value = block.spikerText;
            document.getElementById('editBlockPrompt').value = block.prompt;
            document.getElementById('editBlockAudio').value = block.sfx;
            document.getElementById('editBlockDuration').value = block.duration;
            document.getElementById('editBlockVoiceType').value = block.voiceType;

            document.getElementById('inspectorPanel').classList.remove('hidden');
        }

        function closeInspector() {
            document.getElementById('inspectorPanel').classList.add('hidden');
        }

        function saveBlockChanges() {
            const sc = scenarios.find(s => s.id === currentScenarioId);
            const block = sc.blocks.find(b => b.id === selectedBlockId);
            if (!block) return;

            block.name = document.getElementById('editBlockName').value;
            block.spikerText = document.getElementById('editBlockText').value;
            block.prompt = document.getElementById('editBlockPrompt').value;
            block.sfx = document.getElementById('editBlockAudio').value;
            block.duration = parseInt(document.getElementById('editBlockDuration').value) || 10;
            block.voiceType = document.getElementById('editBlockVoiceType').value;

            localStorage.setItem('tasnif_scenarios', JSON.stringify(scenarios));
            renderTimeline(sc.blocks);
            closeInspector();
        }

        function openImportModal() { document.getElementById('importModal').classList.remove('hidden'); }
        function closeImportModal() { document.getElementById('importModal').classList.add('hidden'); }

        function processJSONImport() {
            try {
                const rawJSON = document.getElementById('jsonInput').value;
                const parsed = JSON.parse(rawJSON);

                const newSc = {
                    id: 'sc_' + Date.now(),
                    title: parsed.title || 'Yangi Gemini Ssenariysi',
                    desc: parsed.desc || 'Gemini AI orqali yuklangan ssenariy',
                    totalTime: '00:45',
                    blocks: parsed.blocks || []
                };

                scenarios.unshift(newSc);
                localStorage.setItem('tasnif_scenarios', JSON.stringify(scenarios));
                currentScenarioId = newSc.id;
                initApp();
                closeImportModal();
            } catch (e) {
                alert('JSON formatida xatolik! Iltimos Gemini taqdim etgan JSON kodni to\'g‘ri nusxalang.');
            }
        }

        function createNewScenario() {
            const title = prompt("Ssenariy nomini kiriting:", "Yangi Tasnif Media Ssenariysi");
            if (!title) return;

            const newSc = {
                id: 'sc_' + Date.now(),
                title: title,
                desc: 'Yangi taymlayn bloki',
                totalTime: '00:20',
                blocks: [
                    { id: 'b_new1', name: 'Spiker 1.1-nutq', spikerText: 'Mavzu bo\'yicha kirish matni...', prompt: '3D cinematic view', sfx: 'Sub drop sound', duration: 10, voiceType: 'Spiker Kadrda', track: 'spiker' },
                    { id: 'b_new2', name: 'AI video 1.1', spikerText: 'Fon ovozidagi matn...', prompt: 'Historical footage AI animation', sfx: 'Background music', duration: 10, voiceType: 'Fon Ovozi (Voiceover)', track: 'aivideo' }
                ]
            };

            scenarios.unshift(newSc);
            localStorage.setItem('tasnif_scenarios', JSON.stringify(scenarios));
            currentScenarioId = newSc.id;
            initApp();
        }

        // Dasturni ishga tushirish
        initApp();
    </script>
</body>
</html>
